{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "jsx": "react",
        "plugins": [{
			"name": "typescript-plugin-css-modules",
			"options": {
                "customMatcher": "\\.sass$",
                "additionalData":
					"@use 'sass:math'\n@use 'app/styles/variables' as *\n@use 'siegel-ui/utils' as *\n"
			}
		}]
    },
    "include": [ "**/*", "../../globals.d.ts" ]
}