{
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react",
        "lib": [ "dom", "esnext" ],
        "outDir": "./lib",
		"target": "esnext",
        "module": "esnext",
		"moduleResolution": "bundler",
        "noEmit": true,
        "allowJs": true,
        "strict": true,
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "paths": {
            "@types/node": [""]
        }
    },
    "include": [ "bin", "client_core", "core", "common", "*.ts" ]
}