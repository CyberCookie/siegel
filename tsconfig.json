{
    "compilerOptions": {
        "jsx": "react",
        "lib": [ "esnext", "dom" ],
        "outDir": "./lib",
		"target": "esnext",
        "module": "esnext",
		"moduleResolution": "bundler",
        "noEmit": true,
        "allowJs": true,
        "strict": true,
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true
    },
    "include": [ "bin", "client_core", "core", "common", "*.ts" ]
}