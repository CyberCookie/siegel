{
    "compilerOptions": {
        "lib": [ "esnext" ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "noEmit": true,
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true
    },
    "include": [ "*.ts" ]
}