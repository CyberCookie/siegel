{
    "name": "siegel",
    "version": "0.17.0",
    "homepage": "https://siegel-qe3q.onrender.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/CyberCookie/siegel.git"
    },
    "bugs": {
        "url": "https://github.com/CyberCookie/siegel/issues"
    },
    "description": "Web application development ecosystem",
    "keywords": [
        "web",
        "web application",
        "create app",
        "cra",
        "create react app",
        "typescript",
        "react",
        "reactjs",
        "bun",
        "bunjs",
        "webpack",
        "base",
        "core",
        "platform",
        "skeleton",
        "metaframework",
        "ecosystem",
        "siegel"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engineStrict": true,
    "engines": {
        "bun": ">= 1.3.14"
    },
    "files": [
        "lib",
        "globals.d.ts",
        "eslint.config.js",
        "tsconfig.base.json"
    ],
    "type": "module",
    "types": "lib/core/index.d.ts",
    "main": "lib/core/index.ts",
    "bin": "lib/bin/index.ts",
    "config": {
        "boot": "bun run demo_app/server/index.ts"
    },
    "scripts": {
        "__docs_gen": "bun mdcreate.ts",
        "__validate": "bun validate.ts && npx jest",
        "__transpile": "bun validate.ts -t",
        "__update": "rm -rf ./node_modules ./bun-lock.json && bun install",
        "prepublishOnly": "npm run __transpile",
        "start": "$npm_package_config_boot -b -s",
        "start_mini": "bun run --server demo_app_minimal/server.ts --client demo_app_minimal/app.ts",
        "build": "$npm_package_config_boot -b -p",
        "build_serv": "$npm_package_config_boot -b -s -p",
        "serv": "$npm_package_config_boot -s -p",
        "deploy": "bun install --no-audit --no-fund && npm run build && npm run serv",
        "validate": "npx eslint . && npx tsc -p ."
    },
    "dependencies": {
        "@eslint/js": "9.39.2",
        "@swc/core": "1.16.1",
        "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
        "autoprefixer": "10.5.4",
        "compression-webpack-plugin": "12.0.0",
        "copy-webpack-plugin": "14.0.0",
        "css-loader": "7.1.5",
        "eslint": "9.39.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-webpack-plugin": "6.0.0",
        "fastify": "5.12.1",
        "globals": "17.12.0",
        "html-webpack-plugin": "5.6.8",
        "mime": "4.1.0",
        "mini-css-extract-plugin": "2.10.2",
        "postcss-loader": "8.2.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-refresh": "0.18.0",
        "sass": "1.103.1",
        "sass-loader": "17.0.1",
        "sass-resources-loader": "2.2.5",
        "style-loader": "4.0.0",
        "svg2ttf": "6.1.0",
        "svgicons2svgfont": "16.0.0",
        "swc-loader": "0.2.7",
        "terser-webpack-plugin": "5.6.1",
        "ttf2woff": "3.0.0",
        "ttf2woff2": "8.0.1",
        "type-fest": "^4.41.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "typescript-plugin-css-modules": "5.2.0",
        "webpack": "5.110.3",
        "webpack-dev-middleware": "8.3.0",
        "webpack-hot-middleware": "2.26.1",
        "worker-loader": "3.0.8"
    },
    "devDependencies": {
        "typedoc": "0.28.16",
        "typedoc-plugin-markdown": "4.9.0"
    },
    "peerDependencies": {
        "@types/bun": "1.3.14",
        "@types/react": "18.3.12",
        "@types/react-dom": "18.3.1",
        "@types/svg2ttf": "5.0.3",
        "@types/ttf2woff": "2.0.4",
        "@types/webpack-env": "1.18.8",
        "@types/webpack-hot-middleware": "2.25.12"
    }
}
