{
    "compilerOptions": {
		"target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [],
        "outDir": "${configDir}../lib",
        "noEmit": true,
        "declaration": true,
        "allowJs": true,
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true
    },
    "include": [
        "${configDir}/**/*",
        "${configDir}/../globals.d.ts"
    ]
}